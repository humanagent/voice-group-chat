# Optional. No DSN means Sentry is not initialized.
# The public DSN is baked into the client at build time. Rebuild after changing it.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Optional separate server DSN; otherwise the server uses the public one.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Source maps: configure these only in the build/deploy environment.
SENTRY_ORG=
SENTRY_PROJECT=
# Secret: never prefix this with NEXT_PUBLIC_ or commit a real value.
SENTRY_AUTH_TOKEN=
